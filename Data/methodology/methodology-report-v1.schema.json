{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamscapetv.github.io/halal-food-eu/schema/methodology-report-v1.json",
  "title": "Halal Food EU methodology candidate report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "methodologyVersion",
    "qualityReportSha256",
    "counts",
    "products",
    "methodologyReportSha256"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "methodologyVersion": {"type": "string", "minLength": 1},
    "qualityReportSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["products", "parserStatus", "reviewQueues", "candidateReasons", "safetyFlags"],
      "properties": {
        "products": {"type": "integer", "minimum": 0},
        "parserStatus": {"$ref": "#/$defs/countMap"},
        "reviewQueues": {"$ref": "#/$defs/countMap"},
        "candidateReasons": {"$ref": "#/$defs/countMap"},
        "safetyFlags": {"$ref": "#/$defs/countMap"}
      }
    },
    "products": {
      "type": "array",
      "items": {"$ref": "#/$defs/product"}
    },
    "methodologyReportSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "countMap": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "text"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleID", "category", "outcome", "reasonCode", "title",
        "ingredientObservationID", "ingredientContentHash", "sourceSpan", "alias", "references"
      ],
      "properties": {
        "ruleID": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "outcome": {"enum": ["prohibited-candidate", "acceptable-with-evidence", "ambiguous-review-required", "informational"]},
        "reasonCode": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "ingredientObservationID": {"type": "string", "pattern": "^hfeu:"},
        "ingredientContentHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sourceSpan": {"$ref": "#/$defs/sourceSpan"},
        "alias": {
          "type": "object",
          "additionalProperties": false,
          "required": ["language", "text"],
          "properties": {
            "language": {"type": "string", "minLength": 1},
            "text": {"type": "string", "minLength": 1}
          }
        },
        "references": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reasons", "checklist", "ingredientObservationID", "ingredientContentHash"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "reasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "checklist": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "ingredientObservationID": {"type": "string", "pattern": "^hfeu:"},
        "ingredientContentHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "methodologyVersion", "gtin", "market",
        "ingredientObservationID", "ingredientContentHash", "sourceLanguage", "sourceText",
        "sourceTextSha256", "freshnessState", "conflictFlags", "parserStatus",
        "candidateFindings", "reviewQueues", "safetyFlags", "analysisSha256"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "methodologyVersion": {"type": "string", "minLength": 1},
        "gtin": {"type": "string", "pattern": "^[0-9]{14}$"},
        "market": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "ingredientObservationID": {"type": ["string", "null"]},
        "ingredientContentHash": {"type": ["string", "null"]},
        "sourceLanguage": {"type": ["string", "null"]},
        "sourceText": {"type": ["string", "null"]},
        "sourceTextSha256": {"type": ["string", "null"]},
        "freshnessState": {"enum": ["fresh", "refresh-recommended", "stale", "date-unknown", "changed-unreviewed"]},
        "conflictFlags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "parserStatus": {"enum": ["unknown", "questionable"]},
        "candidateFindings": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
        "reviewQueues": {"type": "array", "items": {"$ref": "#/$defs/queue"}},
        "safetyFlags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "analysisSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
