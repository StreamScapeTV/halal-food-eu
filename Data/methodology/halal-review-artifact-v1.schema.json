{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamscapetv.github.io/halal-food-eu/schema/halal-review-artifact-v1.json",
  "title": "Halal Food EU immutable review artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "methodologyVersion",
    "analysisSha256",
    "assessmentID",
    "reviewID",
    "decision",
    "reviewerID",
    "reviewedAt",
    "nextReviewAt",
    "limitations",
    "reason",
    "resolvedQueues",
    "openQueuesAtReview",
    "checklists",
    "evidenceIDs",
    "reviewArtifactSha256"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "methodologyVersion": {"type": "string", "minLength": 1},
    "analysisSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "assessmentID": {"type": "string", "pattern": "^hfeu:"},
    "reviewID": {"type": "string", "pattern": "^hfeu:"},
    "decision": {"enum": ["halal-certified", "halal-reviewed", "not-halal", "questionable", "unknown"]},
    "reviewerID": {"type": "string", "minLength": 1},
    "reviewedAt": {"type": "string", "format": "date-time"},
    "nextReviewAt": {"type": "string", "format": "date-time"},
    "limitations": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "resolvedQueues": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9-]*$"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "pattern": "^hfeu:"}
      }
    },
    "openQueuesAtReview": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
    },
    "checklists": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["queueID", "items"],
        "properties": {
          "queueID": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "evidenceIDs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^hfeu:"}
    },
    "reviewArtifactSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
