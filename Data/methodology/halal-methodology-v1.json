  "reviewQueues": [
    {
      "id": "clear-prohibited-confirmation",
      "checklist": [
        "Confirm the matched span is part of the ingredient statement and not allergen/traces text.",
        "Confirm the source observation is exact for the GTIN and market.",
        "Confirm the formulation evidence is current enough under the catalog quality policy.",
        "Record the exact evidence span and any relevant context before a not-halal decision."
      ]
    },
    {
      "id": "ambiguous-origin-process",
      "checklist": [
        "Identify whether the source states ingredient origin or process.",
        "Do not infer animal, plant, microbial, or synthetic origin when absent.",
        "Record manufacturer/certifier/package evidence if available.",
        "Keep the result questionable when material ambiguity remains."
      ]
    },
    {
      "id": "new-changed-formulation",
      "checklist": [
        "Compare exact source text and content hash with the previously reviewed formulation.",
        "Re-run methodology candidates against the new source text.",
        "Do not carry a positive assessment across a changed formulation without compatible explicit review."
      ]
    },
    {
      "id": "positive-ingredient-review",
      "checklist": [
        "Confirm current exact-market ingredient evidence and verification state.",
        "Resolve every candidate and conflict relevant to the methodology.",
        "Record reviewer, methodology version, evidence hash, reasons, limitations, and next review date.",
        "Confirm that halal-reviewed is presented as a review and not a certification."
      ]
    },
    {
      "id": "certification-validity",
      "checklist": [
        "Confirm accepted certifier/scheme policy.",
        "Confirm exact GTIN/product, market, scope, and formulation applicability.",
        "Check effective, expiry, revocation, suspension, and last-checked dates.",
        "Keep conflicts and scope limitations visible."
      ]
    },
    {
      "id": "conflicting-formulation",
      "checklist": [
        "Inspect all current exact-market formulation observations.",
        "Do not resolve the conflict merely by source rank.",
        "Record why one observation becomes current or leave the status questionable."
      ]
    },
    {
      "id": "package-text-verification",
      "checklist": [
        "Compare OCR/translated text against the package or verified source text.",
        "Correct transcription before relying on exact ingredient spans.",
        "Record verification evidence and reviewer identity."
      ]
    },
    {
      "id": "methodology-migration",
      "checklist": [
        "Compare old and new methodology rule sets and compatibility declaration.",
        "Reassess only products affected by changed rules when compatibility allows.",
        "Invalidate prior current assessment when a changed rule can alter its decision."
      ]
    }
  ],
  "changeLog": [
    {
      "version": "1.0.0",
      "date": "2026-08-30",
      "summary": "Initial German/English evidence-candidate methodology. Parser output is non-authoritative and cannot create positive or final negative statuses."
    }
  ]
