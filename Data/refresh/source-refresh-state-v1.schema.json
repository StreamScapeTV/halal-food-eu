{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamscape.tv/halal-food-eu/source-refresh-state-v1.schema.json",
  "title": "Halal Food EU source refresh state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceKey", "market", "policyVersion", "evaluatedAt", "acceptedComplete", "candidateComplete", "lastAttempt", "lastSuccessfulFullAcquisitionAt", "lastSuccessfulFullSnapshotID", "nextFullDueAt", "candidateEligible", "candidateChangedFromAccepted", "stateSha256"],
  "properties": {
    "schemaVersion": {"const": 1},
    "sourceKey": {"type": "string", "minLength": 1},
    "market": {"const": "DE"},
    "policyVersion": {"type": "string", "minLength": 1},
    "evaluatedAt": {"type": "string", "format": "date-time"},
    "acceptedComplete": {"type": ["object", "null"]},
    "candidateComplete": {"type": ["object", "null"]},
    "lastAttempt": {"type": ["object", "null"]},
    "lastSuccessfulFullAcquisitionAt": {"type": ["string", "null"], "format": "date-time"},
    "lastSuccessfulFullSnapshotID": {"type": ["string", "null"], "minLength": 1},
    "nextFullDueAt": {"type": "string", "format": "date-time"},
    "candidateEligible": {"type": "boolean"},
    "candidateChangedFromAccepted": {"type": "boolean"},
    "stateSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
