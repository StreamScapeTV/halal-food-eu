{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamscapetv.github.io/halal-food-eu/schema/halal-review-input-v1.json",
  "title": "Halal Food EU explicit review input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "reviewerID",
    "reviewedAt",
    "nextReviewAt",
    "limitations",
    "reason",
    "resolvedQueues",
    "additionalEvidenceIDs"
  ],
  "properties": {
    "decision": {
      "enum": ["halal-certified", "halal-reviewed", "not-halal", "questionable", "unknown"]
    },
    "reviewerID": {"type": "string", "minLength": 1},
    "reviewedAt": {"type": "string", "format": "date-time"},
    "nextReviewAt": {"type": "string", "format": "date-time"},
    "limitations": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "resolvedQueues": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9-]*$"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "pattern": "^hfeu:[A-Za-z0-9._:-]+$"}
      }
    },
    "additionalEvidenceIDs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^hfeu:[A-Za-z0-9._:-]+$"}
    }
  }
}
