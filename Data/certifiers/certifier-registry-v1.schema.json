{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamscapetv.github.io/halal-food-eu/schemas/certifier-registry-v1.schema.json",
  "title": "Halal Food EU certifier registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registryVersion", "defaultDecision", "reviewedAt", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "registryVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "defaultDecision": {"const": "review-required"},
    "reviewedAt": {"type": "string", "format": "date-time"},
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "sourceApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceKey", "automated", "approvalReference", "credentialNames"],
      "properties": {
        "sourceKey": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$"},
        "automated": {"type": "boolean"},
        "approvalReference": {"type": "string", "minLength": 1},
        "credentialNames": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,99}$"},
          "uniqueItems": true
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certifierKey", "schemeKey", "certifier", "scheme", "legalName", "displayName",
        "markets", "state", "officialReference", "allowedMatchKinds", "maxRecheckAgeDays",
        "sourceApprovals", "reviewerID", "reviewedAt", "nextReviewAt", "limitations",
        "allowedAppWording"
      ],
      "properties": {
        "certifierKey": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"},
        "schemeKey": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"},
        "certifier": {"type": "string", "minLength": 1},
        "scheme": {"type": "string", "minLength": 1},
        "legalName": {"type": "string", "minLength": 1},
        "displayName": {"type": "string", "minLength": 1},
        "markets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z]{2}$"}
        },
        "state": {"enum": ["accepted", "review-required", "blocked", "revoked"]},
        "officialReference": {"type": "string", "pattern": "^https://"},
        "standardReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "recognitionReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "allowedMatchKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["exact-gtin", "explicit-product-list", "exact-batch"]}
        },
        "maxRecheckAgeDays": {"type": "integer", "minimum": 1, "maximum": 3660},
        "sourceApprovals": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceApproval"}
        },
        "reviewerID": {"type": "string", "minLength": 1},
        "reviewedAt": {"type": "string", "format": "date-time"},
        "nextReviewAt": {"type": "string", "format": "date-time"},
        "limitations": {"type": "string", "minLength": 1},
        "allowedAppWording": {"type": "string", "minLength": 1}
      }
    }
  }
}
