{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamscape.tv/halal-food-eu/source-credential-policy-v1.schema.json",
  "title": "Halal Food EU optional source credential policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceKey", "authentication"],
  "properties": {
    "schemaVersion": {"const": 1},
    "sourceKey": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"},
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "requiredSecretNames"],
      "properties": {
        "mode": {"enum": ["api-key", "oauth-client", "username-password", "sftp", "signing-key", "custom"]},
        "requiredSecretNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"}
        }
      }
    }
  }
}
