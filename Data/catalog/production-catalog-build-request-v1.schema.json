{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamscapetv.github.io/halal-food-eu/schemas/production-catalog-build-request-v1.schema.json",
  "title": "Halal Food EU production catalog build request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceHandoffPath",
    "qualityHandoffPath",
    "basicExclusionsHandoffPath",
    "qualityPolicyPath",
    "sourcePolicyPaths",
    "databaseOutputPath",
    "manifestOutputPath",
    "catalogVersion",
    "selectionPolicyVersion",
    "generatedAt",
    "sourceCommit",
    "workflowRun",
    "maxDatabaseBytes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceHandoffPath": { "$ref": "#/$defs/relativePath" },
    "qualityHandoffPath": { "$ref": "#/$defs/relativePath" },
    "basicExclusionsHandoffPath": { "$ref": "#/$defs/relativePath" },
    "qualityPolicyPath": { "$ref": "#/$defs/relativePath" },
    "sourcePolicyPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "databaseOutputPath": { "$ref": "#/$defs/relativePath" },
    "manifestOutputPath": { "$ref": "#/$defs/relativePath" },
    "logicalDumpOutputPath": { "$ref": "#/$defs/relativePath" },
    "releaseNotesOutputPath": { "$ref": "#/$defs/relativePath" },
    "previousManifestPath": { "$ref": "#/$defs/relativePath" },
    "expectedLogicalCatalogSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "catalogVersion": { "$ref": "#/$defs/version" },
    "selectionPolicyVersion": { "$ref": "#/$defs/version" },
    "generatedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "workflowRun": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[0-9A-Za-z][0-9A-Za-z._:/-]*$" },
    "maxDatabaseBytes": { "type": "integer", "minimum": 1, "maximum": 262144000 }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._+-]*$"
    }
  }
}
