{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamscape.tv/halal-food-eu/refresh-report-v1.schema.json",
  "title": "Halal Food EU refresh report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceKey",
    "snapshotID",
    "mode",
    "evaluatedAt",
    "attemptStatus",
    "qualityStatus",
    "candidateEligible",
    "candidateChangedFromAccepted",
    "acceptedSnapshotID",
    "candidateSnapshotID",
    "queueCount",
    "lastSuccessfulFullAcquisitionAt",
    "lastSuccessfulFullSnapshotID",
    "nextFullDueAt",
    "deletionReconciliationAllowed",
    "noFalseFreshness",
    "reportSha256"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "sourceKey": {"type": "string", "minLength": 1},
    "snapshotID": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "minLength": 1},
    "evaluatedAt": {"type": "string", "format": "date-time"},
    "attemptStatus": {"enum": ["complete", "partial", "failed"]},
    "qualityStatus": {"type": "string", "minLength": 1},
    "candidateEligible": {"type": "boolean"},
    "candidateChangedFromAccepted": {"type": "boolean"},
    "acceptedSnapshotID": {"type": ["string", "null"]},
    "candidateSnapshotID": {"type": ["string", "null"]},
    "queueCount": {"type": "integer", "minimum": 0},
    "lastSuccessfulFullAcquisitionAt": {"type": ["string", "null"], "format": "date-time"},
    "lastSuccessfulFullSnapshotID": {"type": ["string", "null"], "minLength": 1},
    "nextFullDueAt": {"type": "string", "format": "date-time"},
    "deletionReconciliationAllowed": {"type": "boolean"},
    "noFalseFreshness": {"const": true},
    "reportSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
