{
  "$defs": {
    "basicRule": {
      "additionalProperties": false,
      "properties": {
        "categorySignals": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "code": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "type": "string"
        },
        "maxIngredientCount": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "code",
        "categorySignals",
        "maxIngredientCount"
      ],
      "type": "object"
    }
  },
  "$id": "https://faruqi.dev/halal-food-eu/schema/catalog-selection-policy-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptedBarcodeKinds": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "allowedProductTypes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "auditSampleSize": {
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
    },
    "basicRules": {
      "items": {
        "$ref": "#/$defs/basicRule"
      },
      "minItems": 1,
      "type": "array"
    },
    "includeCategorySignals": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "includeEvidenceSignals": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "includeFormulationSignals": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "policyVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "targetMarket": {
      "pattern": "^[A-Z]{2}$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "targetMarket",
    "allowedProductTypes",
    "acceptedBarcodeKinds",
    "includeCategorySignals",
    "includeFormulationSignals",
    "includeEvidenceSignals",
    "basicRules",
    "auditSampleSize"
  ],
  "title": "Halal Food EU catalog selection policy v1",
  "type": "object"
}
