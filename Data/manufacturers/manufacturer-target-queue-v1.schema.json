{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamscapetv.github.io/halal-food-eu/schema/manufacturer-target-queue-v1.json",
  "title": "Halal Food EU manufacturer target queue v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceKey", "snapshotID", "generatedAt", "metrics", "items", "limitations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "sourceKey": {"const": "open-food-facts"},
    "snapshotID": {"type": "string", "minLength": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "metrics": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gtin", "market", "sourceRecordID", "priority", "reason", "detail"],
        "properties": {
          "gtin": {"type": "string", "pattern": "^[0-9]{14}$"},
          "market": {"type": "string", "pattern": "^[A-Z]{2}$"},
          "sourceRecordID": {"type": "string", "minLength": 1},
          "ingredientObservationID": {"type": "string", "pattern": "^hfeu:[a-z0-9-]+:sha256:[0-9a-f]{64}$"},
          "producerProvenanceID": {"type": "string", "pattern": "^hfeu:producer-provenance:sha256:[0-9a-f]{64}$"},
          "producerID": {"type": "string", "minLength": 1},
          "priority": {"enum": ["high", "medium", "low"]},
          "reason": {"enum": ["producer-formulation-confirmed", "producer-provenance-candidate", "producer-provenance-ambiguous", "ingredients-missing", "formulation-changed", "ingredient-field-deleted", "evidence-conflict"]},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
